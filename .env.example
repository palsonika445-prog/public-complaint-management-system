# =================================================================
# PUBLIC COMPLAINT MANAGEMENT SYSTEM (PCMS) - ENVIRONMENT VARIABLES
# =================================================================

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
PORT=5001
SECRET_KEY=pcms-enterprise-super-secret-key-2026
JWT_SECRET_KEY=jwt-pcms-token-secret-key-civic-2026
JWT_ACCESS_HOURS=24

# Database Configuration
# In production / Docker Compose with PostgreSQL:
DATABASE_URL=postgresql://pcms_user:pcms_password@localhost:5432/pcms_db
# For zero-config local student development, omit DATABASE_URL to automatically use SQLite fallback.

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Storage
UPLOAD_FOLDER=uploads

# OpenStreetMap / Nominatim Reverse Geocoding
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=PCMS-Civic-Tech-App/1.0

# Optional SMTP Email Configuration (Falls back gracefully when unconfigured)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=notifications@pcms.gov.in
